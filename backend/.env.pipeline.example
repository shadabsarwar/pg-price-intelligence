# Append the settings you need to backend/.env. Existing provider settings remain separate.
# Absolute database path is recommended in production. Defaults to backend/data/intelligence.sqlite3.
# INTELLIGENCE_DB_PATH=D:/Projects/pg-price-intelligence/backend/data/intelligence.sqlite3
# Development fixtures are opt-in and should use a separate database:
INTELLIGENCE_DEMO=0
# Set a private, random token to enable web imports, verification, match review and job submission.
# Do not prefix it NEXT_PUBLIC_ or commit the real value.
INTELLIGENCE_ADMIN_TOKEN=
