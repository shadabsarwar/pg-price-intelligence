# Keep the real SCRAPERAPI_KEY only in backend/.env; never commit it.
SCRAPERAPI_KEY=

# Comma-separated EXACT hostnames, only after confirming permission.
# No schemes, paths, ports, IP literals or wildcards. Subdomains are separate.
# Empty = deny all. No retailer is pre-approved by this project.
APPROVED_RETAILER_DOMAINS=
# Example format (replace with your actually authorized hosts):
# APPROVED_RETAILER_DOMAINS=shop.your-retailer.com,products.your-retailer.com
